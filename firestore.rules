rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Player public profile: owner can update editable profile fields only.
    // Aggregate score fields are server-managed and immutable from clients.
    match /players/{uid} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'age', 'countryCode', 'createdAt'
        ]);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'age', 'countryCode']);
      allow delete: if false;
    }

    // Question bank is readable only to authenticated users.
    // All writes are reserved for trusted administrative tooling.
    match /questionPublic/{questionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Answer keys are server-only. Never expose correctOptionIndex to clients.
    match /questionKeys/{questionId} {
      allow read, write: if false;
    }

    // Attempts and authoritative score records are server-owned.
    match /stageSessions/{sessionId} {
      allow read, write: if false;
    }

    match /stageAttempts/{attemptId} {
      allow read: if signedIn() && resource.data.playerUid == request.auth.uid;
      allow write: if false;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
